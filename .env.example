# Foundry resource endpoint (not the /api/projects/... project URL)
AZURE_ENDPOINT=https://<your-resource>.services.ai.azure.com
DEPLOYMENT_NAME=Decision-1
# Optional: leave empty to use Entra ID (az login)
AZURE_API_KEY=

# LLMs compared against Decision-1 in samples/07 and guard/ (Responses API, comma-separated)
COMPARE_LLMS=gpt-6-luna,gpt-6.1-sol

# Agent loop demo (agent_demo/)
LLM_DEPLOYMENT=gpt-6.1-sol        # chooses tool + arguments (Responses API)
ARG_LLM_DEPLOYMENT=gpt-6-luna     # fills arguments only, after Decision-1 chose the tool
LLM_REASONING_EFFORT=low
ARG_REASONING_EFFORT=low
